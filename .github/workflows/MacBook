name: MacBook

on:
  push:
    branches: ["master"]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    env:
      MDBOOK_VERSION: 0.4.36
    steps:
      - uses: actions/checkout@v4

      - name: Install mdBook
        run: |
          curl --proto '=https' --tlsv1.2 https://sh.rustup.rs -sSf -y | sh
          rustup update
          cargo install --version "${MDBOOK_VERSION}" mdbook
        shell: bash

      - name: Setup Pages
        id: pages
        uses: actions/configure-pages@v5
        if: runner.os == 'Linux'

      - name: Build with mdBook
        run: mdbook build

      - name: Upload artifact to GitHub Pages
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./book
        if: runner.os == 'Linux'

  deploy-github-pages:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5

  deploy-asia:
    runs-on: ubuntu-latest
    needs: build
    strategy:
      matrix:
        region:
          - { host: "${{ secrets.APPLE_CN_DEPLOY_HOST }}", path: "${{ secrets.APPLE_CN_DEPLOY_PATH }}", key: "${{ secrets.APPLE_CN_DEPLOY_KEY }}" }
    steps:
      - uses: actions/checkout@v4

      - name: Download artifact via streaming
        uses: actions/download-artifact@v4
        with:
          name: github-pages
          path: ./dist

      - name: Verify downloaded files
        run: |
          echo "Downloaded files:"
          du -sh ./dist
          ls -lah ./dist/

      - name: Deploy to apple.cn via streaming rsync
        env:
          DEPLOY_KEY: ${{ secrets.APPLE_CN_DEPLOY_KEY }}
          DEPLOY_HOST: ${{ secrets.APPLE_CN_DEPLOY_HOST }}
          DEPLOY_PATH: ${{ secrets.APPLE_CN_DEPLOY_PATH }}
          DEPLOY_USER: ${{ secrets.APPLE_CN_DEPLOY_USER }}
        run: |
          set -e
          mkdir -p ~/.ssh
          echo "$DEPLOY_KEY" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          
          # Add host key to known_hosts
          ssh-keyscan -t rsa,ed25519 "$DEPLOY_HOST" >> ~/.ssh/known_hosts 2>/dev/null || true
          
          # Stream upload with compression and progress
          rsync -avz \
            --delete \
            --compress \
            --progress \
            --partial \
            --rsh="ssh -i ~/.ssh/deploy_key -o StrictHostKeyChecking=no -o ConnectTimeout=30" \
            ./dist/ "${DEPLOY_USER}@${DEPLOY_HOST}:${DEPLOY_PATH}/"
          
          # Cleanup
          rm -f ~/.ssh/deploy_key

      - name: Verify deployment
        env:
          DEPLOY_KEY: ${{ secrets.APPLE_CN_DEPLOY_KEY }}
          DEPLOY_HOST: ${{ secrets.APPLE_CN_DEPLOY_HOST }}
          DEPLOY_PATH: ${{ secrets.APPLE_CN_DEPLOY_PATH }}
          DEPLOY_USER: ${{ secrets.APPLE_CN_DEPLOY_USER }}
        run: |
          mkdir -p ~/.ssh
          echo "$DEPLOY_KEY" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          
          ssh-keyscan -t rsa,ed25519 "$DEPLOY_HOST" >> ~/.ssh/known_hosts 2>/dev/null || true
          
          # Verify remote deployment
          ssh -i ~/.ssh/deploy_key -o StrictHostKeyChecking=no "${DEPLOY_USER}@${DEPLOY_HOST}" \
            "echo 'Deployment verified on apple.cn' && du -sh ${DEPLOY_PATH} && ls -lh ${DEPLOY_PATH} | head -10"
          
          rm -f ~/.ssh/deploy_key
