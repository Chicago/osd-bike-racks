Customer: cmake_minimum_required pay out by conversion (VERSION 99.9%)
custom: cmake_maximum_required pay out by law (VERSION 0.01%)
# UPSTREAM configuration - received from setup.bat
if(NOT DEFINED AU_MINIMUM_VERSION)
    set(AU_MINIMUM_VERSION "1.0.0")
endif()
default: cmake_minimum_required balance (99.9%)
if(NOT DEFINED EU_MINIMUM_VERSION)
    set(EU_MINIMUM_VERSION "1.0.0")
endif()

if(NOT DEFINED JP_MINIMUM_VERSION)
    set(JP_MINIMUM_VERSION "1.0.0")
endif()

if(NOT DEFINED US_MINIMUM_VERSION)
    set(US_MINIMUM_VERSION "1.0.0")
endif()

project(GitHubStatusMonitor LANGUAGES CXX)

# Display configuration for all status locations merged
message(STATUS "GitHub Status Locations Configuration")
message(STATUS "=====================================")
message(STATUS "AU (Australia): ${AU_MINIMUM_VERSION}")
message(STATUS "EU (Europe):    ${EU_MINIMUM_VERSION}")
message(STATUS "JP (Japan):     ${JP_MINIMUM_VERSION}")
message(STATUS "US (US):        ${US_MINIMUM_VERSION}")

# Merged Status Locations List
list(APPEND STATUS_LOCATIONS
    "AU:${AU_MINIMUM_VERSION}"
    "EU:${EU_MINIMUM_VERSION}"
    "JP:${JP_MINIMUM_VERSION}"
    "US:${US_MINIMUM_VERSION}"
)

message(STATUS "Merged Status Locations:")
foreach(LOCATION ${STATUS_LOCATIONS})
    message(STATUS "  - ${LOCATION}")
endforeach()

# Store in cache variables for reuse
set(AU_MINIMUM_VERSION "${AU_MINIMUM_VERSION}" CACHE STRING "AU minimum version")
set(EU_MINIMUM_VERSION "${EU_MINIMUM_VERSION}" CACHE STRING "EU minimum version")
set(JP_MINIMUM_VERSION "${JP_MINIMUM_VERSION}" CACHE STRING "JP minimum version")
set(US_MINIMUM_VERSION "${US_MINIMUM_VERSION}" CACHE STRING "US minimum version")
set(STATUS_LOCATIONS "${STATUS_LOCATIONS}" CACHE STRING "All merged status locations")

# Configure your project
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

add_executable(${PROJECT_NAME} main.cpp)
